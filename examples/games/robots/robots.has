#pragma lockreg(a5);

#include "includes/robots_defs.has";

extern func LoadPlayerShapes() -> int;
extern func LoadBulletShapes() -> int;
extern func MovePlayer() -> void;
extern func InitPlayer(start_x: word, start_y: word) -> void;
extern func InitBullets() -> void;
extern func MoveBullets() -> void;
extern func CreateMap(level: byte) -> void;
extern func CopyLevelBuffer() -> void;

extern var level_start_x: u8;
extern var level_start_y: u8;
extern var fonts: int;

    public main;
    public Init;
    public GameLoop;
    public LoadAnims;

code game_code:

    // Entry point
    asm {
        jsr TakeSystem  ;sets register a5 with CUSTOM chip address
        jsr main    ; call main game procedure
        jmp ReleaseSystem   ;release system and exit
    }

    proc GameLoop() -> void
    {
        var run: bool = TRUE;
        var key: u8;

        call InitBullets();
        call CreateMap(1);
        call InitPlayer(level_start_x * 8, level_start_y * 8);

        while (run == TRUE)
        {
            call SwapScreen();
            call CopyLevelBuffer();

            key = GetKey();

            call MovePlayer();
            call MoveBullets();

            if (key == KEY_ESC)
            {
                run = FALSE;
            }

            call WaitVBlank();
            call Show();
        }
    }

    proc LoadAnims() -> int
    {
        if (LoadPlayerShapes() == -1)
        {
            return -1;
        }

        if (LoadBulletShapes() == -1)
        {
            return -1;
        }

        return 0;
    }

    proc Init() -> int
    {
        call HeapInit();

        if(SetGraphicsMode(0) == -1)
        {
            return -1;
        }

        if(LoadAnims() == -1)
        {
            return -1;
        }

        call SetFont(&fonts);
        call InitKeyboard();

        return 0;
    }

    proc main() -> void {
        if(Init() == 0) {
            call GameLoop();
        }
    }
