// Launchers — educational shoot-em-up example (HAS modern APIs).
// Lock a5 to CUSTOM ($DFF000); HAS will not modify a5.
#pragma lockreg(a5);

#import music "music2.mod" as mus_title;
#import sound "sfx_laser.raw" as sfx_laser;
#import sound "sfx_explosion.raw" as sfx_explosion;
#import sound "sfx_hit.raw" as sfx_hit;

#import bob "launcher.png" as bob_launcher planes=5 add_word;
#import bob "enemy1.png" as bob_enemy1 planes=5 add_word;
#import bob "bullet.png" as bob_bullet planes=5 add_word;
#import bob "expl1.png" as bob_expl1 planes=5 add_word;
#import bob "expl2.png" as bob_expl2 planes=5 add_word;
#import bob "expl3.png" as bob_expl3 planes=5 add_word;
#import bob "expl4.png" as bob_expl4 planes=5 add_word;
#import bob "expl5.png" as bob_expl5 planes=5 add_word;
#import bob "expl6.png" as bob_expl6 planes=5 add_word;
#import bob "mountains.png" as bobx_mountains planes=5;
#import sprite "pointer.png" as sprite_pointer;
#import image "pic.jpg-ham6.iff" as title_pic mode=ham6;

#include "includes/launchers_defs.has";

code game_code:

    // Entry point
    asm {
        jsr TakeSystem  ;sets register a5 with CUSTOM chip address
        jsr main    ; call main game procedure
        jmp ReleaseSystem   ;release system and exit
    }

    native proc peek_w(__reg(a0) a: long) -> int {
        asm {
            move.w (a0),d0
            ext.l  d0
        }
    }

    proc DrawMissiles() -> void
    {
        var i: u8;

        for i = 0 to MAX_BULLETS-1
        {
            if (bullet[i].active != 0)
            {
                var p: bullet*;
                p = &bullet[i];
                call PasteBob(bob_bullet_id, (*p).x, (*p).y, 1);
            }
        }
    }

    proc DrawExplosions() -> void
    {
        var i: u8;
        var frame_id: int;
        var f: int;

        for i = 0 to MAX_EXPLOSION_ANIMS-1
        {
            if (explosions[i].active != 0)
            {
                f = explosions[i].frame_idx;
                frame_id = explosion_frame_id[f];
                call PasteBob(frame_id, explosions[i].x, explosions[i].y, 1);
                f++;
                explosions[i].frame_idx = f;

                if (f >= EXPLOSION_FRAMES)
                {
                    explosions[i].active = 0;
                }
            }
        }
    }

    proc SetExplosionAnimation(x: int, y: int) -> void
    {
        var i: u8;

        for i = 0 to MAX_EXPLOSION_ANIMS-1
        {
            if (explosions[i].active == 0)
            {
                explosions[i].active = 1;
                explosions[i].frame_idx = 0;
                explosions[i].x = x;
                explosions[i].y = y;
                return;
            }
        }
    }

    proc FindEnemyLauncherCollision(ex: int, ey: int) -> int
    {
        var i: int;
        var lx: int;
        var ly: int;
        var lw: int;
        var lh: int;

        i = 0;
        while (i < MAX_LAUNCHERS)
        {
            lx = launcher_x[i];
            ly = SCREEN_HEIGHT - 32;
            lw = GetBobWidth(bob_launcher_id);
            lh = GetBobHeight(bob_launcher_id);

            if (ex > lx && ex < lx + lw && ey > ly && ey < ly + lh)
            {
                return i;
            }

            i += 1;
        }

        return -1;
    }

    proc FindEnemyCollisionWithBullet(bx: int, by: int) -> int
    {
        var i: int;
        var ex: int;
        var ey: int;
        var ew: int;
        var eh: int;

        i = 0;
        while (i < MAX_ENEMIES)
        {
            if (Enemy[i].active != FALSE)
            {
                ex = Enemy[i].x;
                ey = Enemy[i].y;
                ew = GetBobWidth(bob_enemy1_id);
                eh = GetBobHeight(bob_enemy1_id);

                if (bx > ex && bx < ex + ew && by > ey && by < ey + eh)
                {
                    call SetExplosionAnimation(ex, ey);
                    call PlaySound(sfx_hit);
                    return i;
                }
            }

            i += 1;
        }

        return -1;
    }

    proc UpdateMissiles() -> void
    {
        var i: u8;
        var p: bullet*;
        var new_x: int;
        var new_y: int;
        var current_idx: int;

        for i = 0 to MAX_BULLETS-1
        {
            if (bullet[i].active != 0)
            {
                p = &bullet[i];
                current_idx = (*p).idx;

                new_x = ((*p).base_x + (*p).step_x * current_idx) >> 8;
                new_y = ((*p).base_y + (*p).step_y * current_idx) >> 8;
                bullet[i].x = new_x;
                bullet[i].y = new_y;

                current_idx = current_idx + BULLET_SPEED;
                bullet[i].idx = current_idx;

                if (new_x < 0 || new_x > SCREEN_WIDTH-16 || new_y < 0)
                {
                    bullet[i].active = 0; continue;
                }

                current_idx = FindEnemyCollisionWithBullet(new_x, new_y);
                if (current_idx != -1)
                {
                    bullet[i].active = 0;
                    Enemy[current_idx].active = FALSE;
                    score += 10;
                }
            }
        }
    }

    proc LaunchMissile(x0: int, y0: int, xt: int, yt: int) -> void
    {
        var i: u8;
        var dx: int;
        var dy: int;
        var steps: int;
        var abs_dx: int;
        var abs_dy: int;
        var x1: int = xt - 4;
        var y1: int = yt - 4;

        for i = 0 to MAX_BULLETS-1
        {
            if (bullet[i].active == 0)
            {
                dx = x1 - x0;
                dy = y1 - y0;

                abs_dx = dx;
                abs_dy = dy;
                if (abs_dx < 0)
                {
                    abs_dx = -abs_dx;
                }
                if (abs_dy < 0)
                {
                    abs_dy = -abs_dy;
                }

                if (abs_dx > abs_dy)
                {
                    steps = abs_dx;
                }
                if (abs_dy >= abs_dx)
                {
                    steps = abs_dy;
                }

                if (steps <= 0)
                {
                    bullet[i].active = 0;
                    return;
                }

                bullet[i].x = x0;
                bullet[i].y = y0;
                bullet[i].base_x = x0 << 8;
                bullet[i].base_y = y0 << 8;
                bullet[i].step_x = (dx << 8) / steps;
                bullet[i].step_y = (dy << 8) / steps;
                bullet[i].idx = 0;
                bullet[i].active = 1;
                return;
            }
        }
    }

    proc FindClosestLauncher(x: int) -> int
    {
        var i: u8;
        var closest_index: int = -1;
        var closest_dist: int = 0x7FFFFFFF;

        for i = 0 to MAX_LAUNCHERS-1
        {
            var dist: int;
            dist = launcher_x[i];
            if(dist < 0)
            {
                continue;
            }
            dist = dist - x;
            if (dist < 0)
            {
                dist = -dist;
            }

            if (dist < closest_dist)
            {
                closest_dist = dist;
                closest_index = i;
            }
        }

        return closest_index;
    }

    proc MovePointer() -> void
    {
        pos_x += GetMouseDX();
        pos_y += GetMouseDY();

        if(pos_x < 0)
        {
            pos_x = 0;
        }

        if (pos_y < 0)
        {
            pos_y = 0;
        }

        if (pos_x > 312)
        {
            pos_x = 312;
        }

        if (pos_y > 256-16)
        {
            pos_y = 256-16;
        }

        if (GetMouseLBtn() != 0)
        {
            if(button_clicked == FALSE)
            {
                var launcher_index: int;
                var launcher_pos_x: int;
                var w: int = GetBobWidth(bob_bullet_id);

                button_clicked = TRUE;
                if(pos_y < SCREEN_HEIGHT - 32)
                {
                    launcher_index = FindClosestLauncher(pos_x);
                    if(launcher_index == -1)
                    {
                        return;
                    }

                    launcher_pos_x = launcher_x[launcher_index];

                    call PlaySound(sfx_laser);
                    call LaunchMissile(launcher_pos_x + w/2, SCREEN_HEIGHT-32, pos_x + 8, pos_y + 8);
                }
            }
        }
        else
        {
            button_clicked = FALSE;
        }

        call SetSpritePosition(SPRITE_POINTER_ID, pos_x, pos_y);
    }

    proc DrawLaunchers() -> void
    {
        var i: u8;

        for i = 0 to MAX_LAUNCHERS-1
        {
            if(launcher_x[i] < 0)
            {
                continue;
            }
            call PasteBob(bob_launcher_id, launcher_x[i], SCREEN_HEIGHT-32, 1);
        }
    }

    proc SetEnemy(i: int, x: int, y: int, active: u8) -> void {
        Enemy[i].x = x;
        Enemy[i].y = y;
        Enemy[i].active = active;
        Enemy[i].speed = RndMaxAMOS(2) + 1;

        if((Rnd() & 1) == 1)
        {
            Enemy[i].dir = 1;
        }
        else
        {
            Enemy[i].dir = 0;
        }
    }

    proc RandomizeEnemies(count: int) -> void {
        var i: int = 0;
        while (i < count) {
            var rx: int = RndMaxAMOS(SCREEN_WIDTH - 32);
            call SetEnemy(i, rx, 0, TRUE);
            i += 1;
        }
    }

    proc FindInactiveEnemy() -> int
    {
        var i: int;
        var active: u8;

        i = 0;
        while (i < MAX_ENEMIES)
        {
            active = Enemy[i].active;
            if (active == FALSE)
            {
                return i;
            }

            i += 1;
        }

        return -1;
    }

    proc CreateEnemy() -> void
    {
        var x: int;
        var i: int;
        var w: int = GetBobWidth(bob_enemy1_id);

        i = FindInactiveEnemy();
        if (i == -1)
        {
            return;
        }

        x = RndMaxAMOS(SCREEN_WIDTH - w);

        call SetEnemy(i, x, 0, TRUE);
    }

    proc MoveEnemies() -> void
    {
        var i: int;
        var x: int;
        var y: int;
        var launcher_index: int;
        var active: u8;

        i = 0;
        while (i < MAX_ENEMIES)
        {
            active = Enemy[i].active;
            if (active == TRUE)
            {
                y = Enemy[i].y;
                y = y + Enemy[i].speed;

                if (y >= SCREEN_HEIGHT-16)
                {
                    Enemy[i].active = FALSE;
                    i += 1;
                    continue;
                }

                x = Enemy[i].x;
                if(Enemy[i].dir == 0)
                {
                    x = x - 1;
                    if (x <= 0)
                    {
                        x = 0;
                        Enemy[i].dir = 1;
                    }
                }
                else
                {
                    x = x + 1;
                    if (x >= SCREEN_WIDTH - 32)
                    {
                        x = SCREEN_WIDTH - 32;
                        Enemy[i].dir = 0;
                    }
                }

                launcher_index = FindEnemyLauncherCollision(x, y);
                if(launcher_index != -1)
                {
                    Enemy[i].active = FALSE;
                    launcher_x[launcher_index] = -100;
                    call SetExplosionAnimation(x, y);
                    call PlaySound(sfx_explosion);
                    i += 1;
                    continue;
                }

                Enemy[i].x = x;
                Enemy[i].y = y;

                call PasteBob(bob_enemy1_id, x, y, 1);
            }

            i += 1;
        }
    }

    proc IsGameOver() -> bool
    {
        var i: u8;

        for i = 0 to MAX_LAUNCHERS-1
        {
            if (launcher_x[i] >= 0)
            {
                return FALSE;
            }
        }

        return TRUE;
    }

    // Rebake score BOB only when score changes (avoid per-frame heap alloc).
    proc DrawScore() -> void
    {
        var numstr: int;
        var label: int;

        if (score != score_cache)
        {
            if (score_bob != 0)
            {
                call DestroyBob(score_bob);
                score_bob = 0;
            }
            numstr = ItoaAlloc(score);
            label = StrConcatAlloc(&score_txt, numstr);
            call HeapFree(numstr);
            score_bob = PrintToBob(label, 2, TB_MASK_ADDWORD);
            call HeapFree(label);
            score_cache = score;
        }

        if (score_bob != -1 && score_bob != 0)
        {
            // Former Text(5,5) cell → pixel (40, 40)
            call PasteBob(score_bob, 40, 40, 1);
        }
    }

    proc GameOverScreen() -> void
    {
        call SwapScreen();
        call Show();
        call ClearScreen();

        call Text(4, 12, &gameover_txt, 2);
        call HideSprites();

        while(GetMouseLBtn() == 0)
        {
            call ReadMouse();
        }

        score = 0;

        call ShowSprites();
        call InitLaunchers();
        call InitBullets();
        call RandomizeEnemies(MAX_ENEMIES);
    }

    proc GameLoop() -> void
    {
        var run: bool = TRUE;
        var key: u8;

        call PlayMusic(mus_title);
        call SetMusicVolume(12);

        while (run == TRUE)
        {
            call SwapScreen();
            call ClearScreen();

            call DrawScore();

            call PasteBob(bobx_mountains_id, 0, SCREEN_HEIGHT-77, 0);

            call DrawLaunchers();
            call ReadMouse();
            call MovePointer();
            call MoveEnemies();
            call CreateEnemy();
            call UpdateMissiles();
            call DrawMissiles();
            call DrawExplosions();

            key = GetKey();

            if (key == 0x45)
            {
                run = FALSE;
            }

            if(IsGameOver() != FALSE)
            {
                call GameOverScreen();
            }

            call WaitVBlank();
            call Show();
        }

        call QuitAudio();
    }

    proc InitBullets() -> void
    {
        var i: u8;

        for i = 0 to MAX_BULLETS-1
        {
            bullet[i].active = 0;
        }

        for i = 0 to MAX_EXPLOSION_ANIMS-1
        {
            explosions[i].active = 0;
        }
    }

    proc InitLaunchers() -> void
    {
        var i: u8;

        for i = 0 to MAX_LAUNCHERS-1
        {
            launcher_x[i] = SCREEN_WIDTH / MAX_LAUNCHERS * i + 10;
        }
    }

    proc LoadAnims() -> int
    {
        var i: int;

        i = CreateBob(&bob_expl1, 0);
        if(i == -1)
        {
            return -1;
        }
        explosion_frame_id[0] = i;

        i = CreateBob(&bob_expl2, 0);
        if(i == -1)
        {
            return -1;
        }
        explosion_frame_id[1] = i;

        i = CreateBob(&bob_expl3, 0);
        if(i == -1)
        {
            return -1;
        }
        explosion_frame_id[2] = i;

        i = CreateBob(&bob_expl4, 0);
        if(i == -1)
        {
            return -1;
        }
        explosion_frame_id[3] = i;

        i = CreateBob(&bob_expl5, 0);
        if(i == -1)
        {
            return -1;
        }
        explosion_frame_id[4] = i;

        i = CreateBob(&bob_expl6, 0);
        if(i == -1)
        {
            return -1;
        }
        explosion_frame_id[5] = i;

        return 0;
    }

    proc Init() -> int
    {
        var pal: int;
        var color_count: int;
        var i: int;

        call HeapInit();
        call InitAudio();

        sprite_handle = CreateSprite(SPRITE_POINTER_ID, &sprite_pointer);
        if (sprite_handle == -1)
        {
            return -1;
        }

        bob_launcher_id = CreateBob(&bob_launcher, 1);
        if(bob_launcher_id == -1)
        {
            return -1;
        }

        bob_enemy1_id = CreateBob(&bob_enemy1, 0);
        if(bob_enemy1_id == -1)
        {
            return -1;
        }

        bob_bullet_id = CreateBob(&bob_bullet, 0);
        if(bob_bullet_id == -1)
        {
            return -1;
        }

        bobx_mountains_id = CreateBob(&bobx_mountains, 0);
        if(bobx_mountains_id == -1)
        {
            return -1;
        }

        if(LoadAnims() == -1)
        {
            return -1;
        }

        pal = GetBobPalette(bob_launcher_id);

        color_count = 32;
        i = 0;

        while (i < color_count)
        {
            call SetColor(i, peek_w(pal + (i<<1)));
            i += 1;
        }

        call ApplySpritePalette(SPRITE_POINTER_ID);
        call ShowSprite(SPRITE_POINTER_ID);
        call SetFont(&fonts);
        call InitKeyboard();
        call InitLaunchers();
        call InitBullets();
        call RandomizeEnemies(MAX_ENEMIES);

        score_bob = 0;
        score_cache = -1;

        call SetColor(0, 0x12f);
        return 0;
    }

    proc ShowFrontPage() -> void
    {
        call SetGraphicsMode(2);
        call ClearScreen();

        call LoadPalette(&title_pic_palette, 16);
        call ShowPicture(&title_pic);
        call UpdateCopperList();

        while(GetMouseLBtn() == 0)
        {
            call ReadMouse();
        }
    }

    proc main() -> void
    {
        call ShowFrontPage();

        if(SetGraphicsMode(0) == -1)
        {
            return;
        }

        if(Init() == 0)
        {
            call GameLoop();
        }
    }

data game_data:

    pos_x.l = 0
    pos_y.l = 0
    button_clicked: u8 = 0
    score_txt.b = "Score: ",0
    gameover_txt.b = "Game Over! Click to restart.",0
    score.l = 0

bss game_bss:

    sprite_handle.l: 1
    bob_launcher_id.l: 1
    bob_enemy1_id.l: 1
    bob_bullet_id.l: 1
    bobx_mountains_id.l: 1
    score_bob.l: 1
    score_cache.l: 1
    launcher_x.l[MAX_LAUNCHERS]
    explosion_frame_id.l[EXPLOSION_FRAMES]
    struct explosions[MAX_EXPLOSION_ANIMS] {active: u8, frame_idx: u8, x.l, y.l}
    struct bullet[MAX_BULLETS] {x.l, y.l, active: u8, base_x.l, base_y.l, step_x.l, step_y.l, idx.l}
    struct Enemy[MAX_ENEMIES] {x.l, y.l, active: u8, dir: u8, speed: u8}
